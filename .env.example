# --- Auth ---
API_KEY=change-me-to-a-long-random-string

# --- Database ---
# Local dev (docker-compose):
DATABASE_URL=postgresql+asyncpg://facecap:facecap@localhost:5432/facecap

# --- Storage ---
# 'local' uses LOCAL_STORAGE_DIR; 'r2' uses the R2_* vars below.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./_storage

# Cloudflare R2 (only needed when STORAGE_BACKEND=r2)
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_REGION=auto

# --- Job lifecycle ---
BUNDLE_TTL_DAYS=7
MAX_UPLOAD_BYTES=524288000

# --- Static SPA build location ---
WEB_DIST_DIR=./web/dist

# --- Dev CORS (leave empty in prod; same-origin in prod) ---
# CORS_ORIGINS=["http://localhost:5173"]
