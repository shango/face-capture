# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version

# Node / Vite
node_modules/
web/dist/
*.log
.npm

# Environment
.env
.env.local
.env.*.local

# Local storage backend (LocalStorage)
_storage/

# Job working dirs and outputs
jobs/
*.zip

# Large test media (kept locally for smoke tests, not pushed)
*.mp4
*.mov
*.avi
*.mkv
*.csv
*.png

# MediaPipe model weights (downloaded at build/deploy)
*.task

# Maya source scenes — huge (the ARKit head .ma is ~400 MB, over GitHub's
# 100 MB limit). Kept locally; the head is exported once to
# pipeline/assets/arkit_head.usdc (committed) via export_arkit_head_to_usd.py.
*.ma
*.mb

# Auxiliary scripts kept locally but excluded from the web-app deploy
/compare.py
/retarget.py
/maya_import.py
/mapping.example.json

# Windows / WSL artifacts
*:Zone.Identifier
desktop.ini
nul

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Stray legacy files
/gitignore
